# Copy to .env and fill in ONE of these. semcache detects the provider from the
# key's shape, so usually that is all you need.
#
# .env is gitignored. The interactive first run can also save your key to
# ~/.semcache/.env for you, which keeps it out of the project directory.

# --- native SDK providers -----------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- any other provider -------------------------------------------------------
# Grok, OpenRouter and NVIDIA are detected from the key prefix. DeepSeek, Kimi,
# GLM, Groq, Together, Ollama and LM Studio also issue "sk-..." keys, so set
# SEMCACHE_PROVIDER for those.
# SEMCACHE_API_KEY=
# SEMCACHE_PROVIDER=openrouter
# SEMCACHE_MODEL=z-ai/glm-5.2:free
# SEMCACHE_BASE_URL=https://your-gateway/v1

# --- optional tuning ----------------------------------------------------------
# SEMCACHE_THRESHOLD=0.95      # 0.94 is the measured safe floor; see README
# SEMCACHE_PROJECT=my-service  # isolate this project's cache
# SEMCACHE_MAX_ENTRIES=5000
